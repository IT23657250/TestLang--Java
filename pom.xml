<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>se2062</groupId>
  <artifactId>testlangpp-java</artifactId>
  <version>0.1.0</version>
  <name>TestLang++ (Java) – Backend API Testing DSL</name>
  <description>Scanner+Parser (JFlex/CUP) that compiles .test DSL to JUnit 5 over java.net.http.HttpClient</description>
  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <cup.version>11b-20160615</cup.version>
    <jflex.plugin.version>1.10.1</jflex.plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>java-cup</groupId>
      <artifactId>java-cup</artifactId>
      <version>${cup.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>de.jflex</groupId>
        <artifactId>jflex-maven-plugin</artifactId>
        <version>${jflex.plugin.version}</version>
        <executions>
          <execution>
            <id>generate-lexer</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <lexDefinitions>
                <lexDefinition>src/main/jflex/lexer.flex</lexDefinition>
              </lexDefinitions>
              <outputDirectory>${project.build.directory}/generated-sources/jflex</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-cup-parser</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>java_cup.Main</mainClass>
              <arguments>
                <argument>-parser</argument>
                <argument>Parser</argument>
                <argument>-symbols</argument>
                <argument>Sym</argument>
                <argument>-locations</argument>
                <argument>-expect</argument>
                <argument>100</argument>
                <argument>-destdir</argument>
                <argument>${project.build.directory}/generated-sources/cup</argument>
                <argument>-package</argument>
                <argument>tl.parser</argument>
                <argument>src/main/cup/parser.cup</argument>
              </arguments>
              <systemProperties>
                <systemProperty>
                  <key>java.awt.headless</key>
                  <value>true</value>
                </systemProperty>
              </systemProperties>
              <classpathScope>compile</classpathScope>
            </configuration>
          </execution>

          <execution>
            <id>compile-dsl-to-junit</id>
            <phase>generate-test-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>tl.compiler.TestLangCompiler</mainClass>
              <arguments>
                <argument>${project.basedir}/src/test/resources/example.test</argument>
                <argument>${project.build.directory}/generated-test-sources/test</argument>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-generated-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/jflex</source>
                <source>${project.build.directory}/generated-sources/cup</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-generated-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-test-sources/test</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <includes>
            <include>**/GeneratedTests.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>